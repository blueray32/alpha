{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Slash /build request",
  "type": "object",
  "properties": {
    "feature": {
      "type": "string",
      "description": "Feature name or description"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of task descriptions"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        },
        "required": ["path", "content"]
      },
      "description": "Files to write with their content"
    },
    "respect_contracts": {
      "type": "boolean",
      "default": true
    }
  },
  "required": []
}